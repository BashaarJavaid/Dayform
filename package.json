{
  "name": "dayform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/food-search",
    "server",
    "simulator/backend",
    "simulator/frontend",
    "cards",
    "jobs/overnight",
    "db",
    "data",
    "infra",
    "mock",
    "demo"
  ],
  "scripts": {
    "mock": "npm run start -w @dayform/mock",
    "dev": "npm run dev -w @dayform/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p packages/contracts && tsc -p mock && tsc -p demo && tsc -p server",
    "demo": "npm run demo -w @dayform/demo",
    "format": "prettier --write packages mock",
    "demo:scene": "npm run demo:scene -w @dayform/demo --",
    "demo:warm": "npm run demo:warm -w @dayform/demo",
    "data:load-catalog": "npm run data:load-catalog -w @dayform/data",
    "catalog:link": "npm run catalog:link -w @dayform/data",
    "db:migrate": "npm run db:migrate -w @dayform/db --",
    "db:reset": "npm run db:reset -w @dayform/db --",
    "db:hash": "npm run db:hash -w @dayform/db --",
    "db:report": "npm run db:report -w @dayform/db --",
    "data:load-foods": "npm run load -w @dayform/food-search",
    "cards:build": "npm run cards:build -w @dayform/cards",
    "cards:preview": "npm run cards:preview -w @dayform/cards",
    "cards:screens": "npm run cards:screens -w @dayform/cards",
    "mealprep:bench": "npm run mealprep:bench -w @dayform/server --"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
