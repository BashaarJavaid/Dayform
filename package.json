{
  "name": "dayform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/food-search",
    "server",
    "simulator/backend",
    "simulator/frontend",
    "cards",
    "jobs/overnight",
    "db",
    "data",
    "infra",
    "mock",
    "demo"
  ],
  "scripts": {
    "mock": "npm run start -w @dayform/mock",
    "dev": "echo 'npm run dev: the real MCP server arrives with T-20; use npm run mock' && exit 1",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p packages/contracts && tsc -p mock && tsc -p demo",
    "demo": "npm run demo -w @dayform/demo",
    "format": "prettier --write packages mock",
    "demo:scene": "npm run demo:scene -w @dayform/demo --",
    "demo:warm": "npm run demo:warm -w @dayform/demo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  }
}
